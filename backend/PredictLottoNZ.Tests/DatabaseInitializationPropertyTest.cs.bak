using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;

namespace PredictLottoNZ.Tests;

/// <summary>
/// **Feature: predict-lotto-nz, Property 16: Database initialization is complete**
/// **Validates: Requirements 9.3**
/// 
/// Standalone property-based test for database initialization functionality.
/// For any PostgreSQL service startup, the system should create the required database schema 
/// with all migrations applied and verify that all tables are accessible.
/// </summary>
public static class DatabaseInitializationPropertyTest
{
    public static async Task RunDatabaseInitializationPropertyTest()
    {
        Console.WriteLine("Running Database Initialization Property Test...");
        Console.WriteLine("================================================");

        try
        {
            Console.WriteLine("Property Test 16: Database initialization is complete...");
            await DatabaseInitializationIsComplete_PropertyTest();
            Console.WriteLine("✓ PASSED: Database initialization is complete (100 iterations)");
            
            Console.WriteLine("\nProperty Test 16b: Database initialization is idempotent...");
            await DatabaseInitializationIsIdempotent_PropertyTest();
            Console.WriteLine("✓ PASSED: Database initialization is idempotent (50 iterations)");
            
            Console.WriteLine("\nProperty Test 16c: Database schema verification detects all tables...");
            await DatabaseSchemaVerificationDetectsAllTables_PropertyTest();
            Console.WriteLine("✓ PASSED: Database schema verification detects all tables (50 iterations)");
            
            Console.WriteLine("\n================================================");
            Console.WriteLine("Database initialization property tests PASSED!");
            Console.WriteLine("Property 16: Database initialization is complete - VALIDATED");
            Console.WriteLine("Requirements 9.3 - SATISFIED");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ DATABASE INITIALIZATION TEST FAILED: {ex.Message}");
            throw;
        }
    }

    /// <summary>
    /// Property test: Database initialization should be complete for any valid configuration
    /// This test runs multiple iterations with different database configurations to verify
    /// that initialization always results in a complete, queryable database schema.
    /// </summary>
    private static async Task DatabaseInitializationIsComplete_PropertyTest()
    {
        const int iterations = 100;
        var random = new Random(42); // Fixed seed for reproducibility
        
        for (int i = 0; i < iterations; i++)
        {
            // Generate random valid database configuration
            var config = GenerateValidDatabaseConfiguration(random, i);
            
            // Arrange: Create in-memory database with unique name for isolation
            var options = new DbContextOptionsBuilder<TestLottoDbContext>()
                .UseInMemoryDatabase($"TestDb_{config.DatabaseName}_{Guid.NewGuid()}")
                .Options;

            using var context = new TestLottoDbContext(options);
            
            var loggerFactory = LoggerFactory.Create(builder => builder.AddConsole().SetMinimumLevel(LogLevel.Warning));
            var logger = loggerFactory.CreateLogger<TestDatabaseInitializationService>();
            var initService = new TestDatabaseInitializationService(context, logger);

            try
            {
                // Act: Initialize the database
                await initService.InitializeAsync();

                // Assert: Verify database initialization is complete
                await VerifyDatabaseIsComplete(context);
            }
            catch (Exception ex)
            {
                throw new Exception($"Iteration {i}: Database initialization failed: {ex.Message}", ex);
            }
        }
    }

    /// <summary>
    /// Property test: Database initialization should be idempotent
    /// Running initialization multiple times should not cause errors or data corruption.
    /// </summary>
    private static async Task DatabaseInitializationIsIdempotent_PropertyTest()
    {
        const int iterations = 50;
        var random = new Random(42);
        
        for (int i = 0; i < iterations; i++)
        {
            var config = GenerateValidDatabaseConfiguration(random, i);
            
            // Arrange: Create in-memory database
            var options = new DbContextOptionsBuilder<TestLottoDbContext>()
                .UseInMemoryDatabase($"IdempotentTestDb_{config.DatabaseName}_{Guid.NewGuid()}")
                .Options;

            using var context = new TestLottoDbContext(options);
            
            var loggerFactory = LoggerFactory.Create(builder => builder.AddConsole().SetMinimumLevel(LogLevel.Warning));
            var logger = loggerFactory.CreateLogger<TestDatabaseInitializationService>();
            var initService = new TestDatabaseInitializationService(context, logger);

            try
            {
                // Act: Initialize database multiple times
                await initService.InitializeAsync();
                await initService.InitializeAsync();
                await initService.InitializeAsync();

                // Assert: Verify database is still complete and functional
                await VerifyDatabaseIsComplete(context);
            }
            catch (Exception ex)
            {
                throw new Exception($"Iteration {i}: Idempotent initialization failed: {ex.Message}", ex);
            }
        }
    }

    /// <summary>
    /// Property test: Database schema verification should detect all required tables
    /// The verification process should be able to query all entity tables successfully.
    /// </summary>
    private static async Task DatabaseSchemaVerificationDetectsAllTables_PropertyTest()
    {
        const int iterations = 50;
        var random = new Random(42);
        
        for (int i = 0; i < iterations; i++)
        {
            var config = GenerateValidDatabaseConfiguration(random, i);
            
            // Arrange: Create and initialize database
            var options = new DbContextOptionsBuilder<TestLottoDbContext>()
                .UseInMemoryDatabase($"SchemaTestDb_{config.DatabaseName}_{Guid.NewGuid()}")
                .Options;

            using var context = new TestLottoDbContext(options);
            
            var loggerFactory = LoggerFactory.Create(builder => builder.AddConsole().SetMinimumLevel(LogLevel.Warning));
            var logger = loggerFactory.CreateLogger<TestDatabaseInitializationService>();
            var initService = new TestDatabaseInitializationService(context, logger);

            try
            {
                // Act: Initialize database
                await initService.InitializeAsync();

                // Assert: Verify all required tables exist and are queryable
                var lottoDrawsExist = await CanQueryTable(() => context.LottoDraws.CountAsync());
                var combinationsExist = await CanQueryTable(() => context.NumberCombinations.CountAsync());
                var predictionsExist = await CanQueryTable(() => context.Predictions.CountAsync());

                if (!lottoDrawsExist || !combinationsExist || !predictionsExist)
                    throw new Exception($"Iteration {i}: Schema verification failed - not all tables are queryable");
            }
            catch (Exception ex)
            {
                throw new Exception($"Iteration {i}: Schema verification failed: {ex.Message}", ex);
            }
        }
    }

    private static async Task VerifyDatabaseIsComplete(TestLottoDbContext context)
    {
        // Verify database can be connected to
        var canConnect = await context.Database.CanConnectAsync();
        if (!canConnect)
            throw new InvalidOperationException("Cannot connect to database");

        // Verify all required tables exist and are queryable
        var lottoDrawCount = await context.LottoDraws.CountAsync();
        var combinationCount = await context.NumberCombinations.CountAsync();
        var predictionCount = await context.Predictions.CountAsync();

        // Verify we can perform basic operations on each table
        // This ensures the schema is properly created with all required columns and constraints
        
        // Test LottoDraws table structure
        var testDraw = new LottoDraw
        {
            Draw = 9999,
            Date = DateTime.UtcNow.Date,
            WinningNumber1 = 1,
            WinningNumber2 = 2,
            WinningNumber3 = 3,
            WinningNumber4 = 4,
            WinningNumber5 = 5,
            WinningNumber6 = 6,
            BonusNumber = 7,
            Powerball = 8
        };
        
        context.LottoDraws.Add(testDraw);
        await context.SaveChangesAsync();
        
        var retrievedDraw = await context.LottoDraws.FirstOrDefaultAsync(d => d.Draw == 9999);
        if (retrievedDraw == null)
            throw new InvalidOperationException("Failed to insert and retrieve test draw");

        // Test NumberCombinations table structure
        var testCombination = new NumberCombination();
        testCombination.SetNumbers(new[] { 10, 11, 12, 13, 14, 15 });
        
        context.NumberCombinations.Add(testCombination);
        await context.SaveChangesAsync();
        
        var retrievedCombination = await context.NumberCombinations.FirstOrDefaultAsync(c => c.Number1 == 10);
        if (retrievedCombination == null)
            throw new InvalidOperationException("Failed to insert and retrieve test combination");

        // Test Predictions table structure
        var testPrediction = new Prediction
        {
            Source = "Test",
            Number1 = 20,
            Number2 = 21,
            Number3 = 22,
            Number4 = 23,
            Number5 = 24,
            Number6 = 25
        };
        
        context.Predictions.Add(testPrediction);
        await context.SaveChangesAsync();
        
        var retrievedPrediction = await context.Predictions.FirstOrDefaultAsync(p => p.Source == "Test");
        if (retrievedPrediction == null)
            throw new InvalidOperationException("Failed to insert and retrieve test prediction");

        // Clean up test data
        context.LottoDraws.Remove(retrievedDraw);
        context.NumberCombinations.Remove(retrievedCombination);
        context.Predictions.Remove(retrievedPrediction);
        await context.SaveChangesAsync();
    }

    private static async Task<bool> CanQueryTable(Func<Task<int>> queryFunc)
    {
        try
        {
            await queryFunc();
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static DatabaseConfiguration GenerateValidDatabaseConfiguration(Random random, int iteration)
    {
        return new DatabaseConfiguration
        {
            DatabaseName = $"TestDatabase_{iteration}_{random.Next(1, 1000)}",
            ConnectionTimeout = TimeSpan.FromSeconds(random.Next(10, 60)),
            RetryCount = random.Next(1, 5)
        };
    }

    private class DatabaseConfiguration
    {
        public string DatabaseName { get; set; } = string.Empty;
        public TimeSpan ConnectionTimeout { get; set; }
        public int RetryCount { get; set; }
    }
}